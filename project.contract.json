{
  "schemaVersion": 1,
  "id": "corporate/tropisip",
  "owner": "Gaffer (dr. Ferdi Iskandar)",
  "risk": "R1",
  "runtime": {
    "name": "node",
    "version": "24"
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": {
      "program": "pnpm",
      "args": ["install", "--frozen-lockfile"]
    },
    "lint": {
      "program": null,
      "args": [],
      "notApplicableReason": "Strict TypeScript compiler checks (noUnusedLocals, noUnusedParameters, strict) and Vitest static compliance tests guard code quality for this self-contained editorial capsule."
    },
    "typecheck": {
      "program": "pnpm",
      "args": ["run", "typecheck"]
    },
    "test": {
      "program": "pnpm",
      "args": ["run", "test"]
    },
    "build": {
      "program": "pnpm",
      "args": ["run", "build"]
    },
    "run": {
      "program": "pnpm",
      "args": ["run", "preview"]
    },
    "deployDryRun": {
      "program": "pnpm",
      "args": ["run", "deploy:dry-run"]
    }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 4180,
    "path": "/",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 15
  },
  "artifacts": ["dist"],
  "externalDependencies": [],
  "mutableStatePaths": []
}
